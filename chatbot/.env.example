GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del backend de RutSeg — usada solo para GET /api/courses (público, sin
# auth) al refrescar el catálogo de cursos que Uchi usa en su system prompt.
# En local, el default (http://localhost:3000) ya funciona si corres `bun dev` en backend/.
# En Railway, hay que setearla al dominio real del servicio backend
# (ej. https://tu-backend.up.railway.app).
RUTSEG_API_URL=http://localhost:3000

# Cada cuántos segundos se refresca el catálogo de cursos. Default: 3600 (1 hora).
CATALOG_REFRESH_SECONDS=3600
